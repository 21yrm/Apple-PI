{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Apple-PI dataset manifest",
  "type": "object",
  "required": ["name", "version", "num_rollouts", "cases"],
  "properties": {
    "name": {"const": "Apple-PI"},
    "version": {"type": "string"},
    "prompt_version": {"type": "string"},
    "num_rollouts": {"const": 3},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["case_id", "path"],
        "properties": {
          "case_id": {"type": "string"},
          "path": {"type": "string"},
          "split": {"type": "string"}
        }
      }
    }
  }
}
